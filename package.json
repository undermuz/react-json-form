{
  "name": "react-json-form",
  "private": true,
  "workspaces": [
    "packages/react-json-form",
    "packages/themes/*",
    "www/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "dev:home": "npm run dev --workspace=@undermuz/react-json-form-home",
    "dev:home-base": "npm run dev --workspace=@undermuz/react-json-form-home-base",
    "dev:home-chakra": "npm run dev --workspace=@undermuz/react-json-form-home-chakra",
    "dev:home-chakra3": "npm run dev --workspace=@undermuz/react-json-form-home-chakra3",
    "dev:home-grommet": "npm run dev --workspace=@undermuz/react-json-form-home-grommet",
    "dev:home-heroui": "npm run dev --workspace=@undermuz/react-json-form-home-heroui",
    "dev:home-rsuite": "npm run dev --workspace=@undermuz/react-json-form-home-rsuite",
    "dev:home-antd": "npm run dev --workspace=@undermuz/react-json-form-home-antd",
    "dev:home-mantine": "npm run dev --workspace=@undermuz/react-json-form-home-mantine",
    "dev:home-mui": "npm run dev --workspace=@undermuz/react-json-form-home-mui",
    "build:home:pages": "node www/scripts/build-home-pages.mjs",
    "deploy:home": "npm run build:home:pages && gh-pages -d www/dist-pages -b gh-pages --dotfiles -m \"Deploy home-page to GitHub Pages\""
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "nx": "23.1.1"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "vite": "^8.2.0",
    "@undermuz/react-json-form-theme-mantine": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2"
    },
    "@undermuz/react-json-form-home-mantine": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8"
    }
  }
}