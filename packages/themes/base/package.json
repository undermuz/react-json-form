{
  "name": "@undermuz/react-json-form-theme-base",
  "homepage": "http://undermuz.github.io/react-json-form",
  "version": "2.3.1",
  "description": "Zero-dependency base theme for @undermuz/react-json-form",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src && npm run typecheck",
    "build": "npm run build:tsup",
    "build:tsup": "tsup && node ./scripts/copy-styles.mjs",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "author": {
    "name": "undermuz",
    "email": "undermuz@gmail.com",
    "url": "https://github.com/undermuz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/undermuz/react-json-form.git"
  },
  "license": "MIT",
  "dependencies": {
    "@undermuz/use-form": "2.0.0-alpha.0"
  },
  "peerDependencies": {
    "@undermuz/react-json-form": "^2.3.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@undermuz/react-json-form": "*",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "prettier": "^2.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "keywords": [
    "react",
    "form",
    "forms",
    "theme",
    "json-form"
  ]
}
