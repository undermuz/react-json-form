{
  "name": "@undermuz/react-json-form-theme-base-dnd-tabs",
  "homepage": "http://undermuz.github.io/react-json-form",
  "version": "2.3.0",
  "description": "DnD ArrayFormList (sortable items + trash) for @undermuz/react-json-form themes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "npm run build:tsup",
    "build:tsup": "tsup",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "author": {
    "name": "undermuz",
    "email": "undermuz@gmail.com",
    "url": "https://github.com/undermuz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/undermuz/react-json-form.git"
  },
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0"
  },
  "peerDependencies": {
    "@undermuz/react-json-form": "^2.2.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@undermuz/react-json-form": "*",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "react",
    "form",
    "forms",
    "theme",
    "json-form",
    "dnd",
    "drag-and-drop"
  ]
}
