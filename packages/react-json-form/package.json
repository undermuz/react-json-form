{
  "name": "@undermuz/react-json-form",
  "homepage": "http://undermuz.github.io/react-json-form",
  "version": "2.3.1",
  "description": "Generate JSON-based forms with react",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "esmodules": "./dist/index.mjs",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src && npm run typecheck",
    "build": "npm run build:tsup",
    "build:tsup": "tsup",
    "predeploy": "npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run predeploy"
  },
  "author": {
    "name": "undermuz",
    "email": "undermuz@gmail.com",
    "url": "https://github.com/undermuz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/undermuz/react-json-form.git"
  },
  "license": "MIT",
  "dependencies": {
    "@undermuz/use-form": "2.0.0-alpha.0",
    "react-error-boundary": "^3.1.4",
    "underscore": "^1.13.4"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^22.15.0",
    "@types/react": "^18.0.5",
    "@types/react-dom": "^18.0.5",
    "@types/underscore": "^1.11.4",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "jsdom": "^26.0.0",
    "prettier": "^2.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "react",
    "form",
    "forms",
    "use-form",
    "hook"
  ]
}
